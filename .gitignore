# ==============================================================================
# T.R.A.C.E. (GEOAI 04) - .gitignore
# ==============================================================================

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.so

# Python Virtual Environments
.venv/
venv/
ENV/
env/
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg

# Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Heavy Raw Datasets & Archive Dumps
Onera Satellite Change Detection/
data/raw/
*.tar.gz
*.tar
*.zip
*.7z

# Model Checkpoints & Large Binaries
checkpoints/*.pth
checkpoints/*.onnx
checkpoints/*.bin
!checkpoints/BIT_LEVIR_best.pt
!checkpoints/s2_track_b.pt
!checkpoints/.gitkeep

# IDE & Editor Configurations
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo

# Environment Variables & Secrets
.env
.env.*
*.key
*.pem
*.secret

# Logs & Temporary Scratch Artifacts
*.log
scratch/
.system_generated/

# Runtime Upload Sessions & Ephemeral Test Outputs
data/sessions/
data/outputs/ANL_*/
data/outputs/test_reports/
data/outputs/changeintel_CHG_0001_report.pdf
data/outputs/changeintel_full_report.pdf

