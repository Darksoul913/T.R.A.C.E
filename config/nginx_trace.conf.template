# ==============================================================================
# 🛰️ High-Performance Nginx Reverse Proxy for T.R.A.C.E.
# Port 80 (Public HTTP) -> Port 8765 (FastAPI / Uvicorn Server)
# ==============================================================================

server {
    listen 80 default_server;
    listen [::]:80 default_server;
    server_name _;

    # Maximum upload size for large multi-band GeoTIFF satellite files (500 MB)
    client_max_body_size 500M;
    client_body_buffer_size 128k;

    # Performance optimizations
    sendfile on;
    tcp_nopush on;
    tcp_nodelay on;
    keepalive_timeout 65;

    # High-Performance Gzip Compression
    gzip on;
    gzip_static on;             # Serves pre-compressed .gz assets (index.html.gz) directly from disk
    gzip_proxied any;           # CRITICAL: Compresses proxied backend API responses from FastAPI!
    gzip_vary on;
    gzip_comp_level 6;          # Balanced high compression & CPU efficiency
    gzip_min_length 256;
    gzip_buffers 16 8k;
    gzip_http_version 1.1;
    gzip_types
        text/plain
        text/css
        text/xml
        text/javascript
        application/json
        application/javascript
        application/x-javascript
        application/xml
        application/xml+rss
        image/svg+xml;

    # Root directory pointing to web assets
    root __REPO_PATH__/web;

    # 1. Direct Static File Serving for pre-built assets (zero Python overhead)
    location ~* \.(?:json|js|css|png|jpg|jpeg|gif|svg|ico|woff2?|gpkg|pdf)$ {
        try_files $uri @backend;
        expires 7d;
        add_header Cache-Control "public, max-age=604800, stale-while-revalidate=86400";
        gzip_static on;
    }

    # 2. Main Entrypoint: serve pre-compressed index.html directly from disk
    location = / {
        try_files /index.html @backend;
        add_header Cache-Control "public, max-age=3600, stale-while-revalidate=86400";
        gzip_static on;
    }

    # 3. Content-hashed build assets (images, data bundle, downloads): filenames change when content does
    location ^~ /static/a/ {
        alias __REPO_PATH__/web/a/;
        add_header Cache-Control "public, max-age=31536000, immutable";
        gzip_static on;
    }

    # 4. Static mount fallback (^~ so the extension regex above doesn't send it to FastAPI)
    location ^~ /static/ {
        alias __REPO_PATH__/web/;
        expires 7d;
        add_header Cache-Control "public, max-age=604800, stale-while-revalidate=86400";
        gzip_static on;
    }

    # 5. All Dynamic API & WebSocket routes -> Proxied to FastAPI on 127.0.0.1:8765
    location / {
        try_files $uri @backend;
    }

    location @backend {
        proxy_pass http://127.0.0.1:8765;
        proxy_http_version 1.1;

        # WebSocket & connection upgrade support
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Extended timeouts for large satellite tiling and GPU inference
        proxy_connect_timeout 600s;
        proxy_send_timeout 600s;
        proxy_read_timeout 600s;
        send_timeout 600s;

        # Buffer tuning for large GeoTIFF uploads and API responses
        proxy_buffering on;
        proxy_buffer_size 128k;
        proxy_buffers 4 256k;
        proxy_busy_buffers_size 256k;
    }
}
