[Unit]
Description=T.R.A.C.E. Bi-Temporal Satellite Change Intelligence Engine
After=network.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/HFD
EnvironmentFile=-/home/ubuntu/HFD/.env
ExecStart=/home/ubuntu/HFD/.venv/bin/uvicorn src.server.app:app --host 127.0.0.1 --port 8765 --workers 1 --proxy-headers --forwarded-allow-ips 127.0.0.1
Restart=always
RestartSec=5
RestartPreventExitStatus=
KillMode=mixed
TimeoutStopSec=10
StandardOutput=journal
StandardError=journal
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
